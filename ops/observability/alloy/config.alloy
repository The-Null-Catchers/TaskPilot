logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "taskpilot" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "taskpilot" {
  targets = discovery.docker.taskpilot.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "api|worker|beat|web|minio|postgres|redis"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
    replacement   = "$1"
  }
}

loki.source.docker "taskpilot" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.taskpilot.output
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
