APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=false
METRICS_TOKEN=
APP_URL=https://taskpilot.example.com
API_URL=https://api.taskpilot.example.com
NEXT_PUBLIC_API_URL=https://api.taskpilot.example.com

POSTGRES_DB=taskpilot
POSTGRES_USER=taskpilot
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://taskpilot:CHANGE_ME@postgres:5432/taskpilot

REDIS_URL=redis://redis:6379/0

JWT_SECRET=
NOTIFICATION_SECRET=
INTEGRATION_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ACCOUNT_TOKEN_MINUTES=60
TRUST_PROXY_HEADERS=true

CORS_ORIGINS=https://taskpilot.example.com

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=https://files.taskpilot.example.com
STORAGE_BUCKET=taskpilot
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_REGION=us-east-1
STORAGE_MAX_FILE_BYTES=20971520
STORAGE_WORKSPACE_QUOTA_BYTES=2147483648
STORAGE_PRESIGN_SECONDS=300
STORAGE_SSE=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=TaskPilot <no-reply@taskpilot.example.com>
SMTP_STARTTLS=true

WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:admin@taskpilot.example.com
FCM_SERVICE_ACCOUNT_JSON=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_USE_SANDBOX=false

BIND_HOST=127.0.0.1
WEB_PORT=3000
API_PORT=8000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
WEB_CONCURRENCY=2
CELERY_CONCURRENCY=2
